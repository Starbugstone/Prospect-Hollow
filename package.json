{
  "name": "prospect-hollow",
  "version": "1.0.0",
  "private": true,
  "description": "Prospect Hollow is a frontier town-building puzzle game where gem mining funds a settlement that grows through new eras.",
  "main": "src/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets": "node scripts/generate-gems.mjs && node scripts/generate-bonus-art.mjs",
    "verify": "npm run format:check && npm test && npm run build",
    "demo:eras": "node scripts/create-era-demo.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Starbugstone/Prospect-Hollow.git"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bugs": {
    "url": "https://github.com/Starbugstone/Prospect-Hollow/issues"
  },
  "homepage": "https://github.com/Starbugstone/Prospect-Hollow#readme",
  "dependencies": {
    "@capacitor/core": "^7.4.4",
    "howler": "^2.2.4",
    "phaser": "^3.86.0",
    "pinia": "^3.0.3",
    "three": "^0.183.2",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "prettier": "^3.9.6",
    "vite": "^7.1.12",
    "vitest": "^4.0.10"
  }
}
