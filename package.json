{
  "name": "prospect-hollow",
  "version": "1.1.1-beta",
  "private": true,
  "description": "Prospect Hollow is a frontier town-building puzzle game where gem mining funds a settlement that grows through new eras.",
  "main": "src/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:levels": "vitest run --config vitest.levels.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "export:save-rules": "node scripts/export-save-rules.mjs",
    "check:save-rules": "node scripts/export-save-rules.mjs --check",
    "export:integrity-fixtures": "node scripts/create-integrity-fixtures.mjs",
    "check:integrity-fixtures": "node scripts/create-integrity-fixtures.mjs --check",
    "assets": "node scripts/generate-gems.mjs && node scripts/generate-bonus-art.mjs",
    "lint": "eslint . && knip",
    "verify": "npm run format:check && npm run lint && npm run check:footprints && npm test && npm run build",
    "demo:eras": "node scripts/create-era-demo.mjs",
    "predev": "node scripts/split-mesh-catalogs.mjs",
    "pretest": "node scripts/split-mesh-catalogs.mjs",
    "pretest:levels": "node scripts/split-mesh-catalogs.mjs",
    "prebuild": "node scripts/split-mesh-catalogs.mjs",
    "postbuild": "node scripts/check-bundle-budget.mjs",
    "assets:footprints": "node scripts/generate-footprints.mjs",
    "check:footprints": "node scripts/generate-footprints.mjs --check",
    "assets:board": "node scripts/generate-board-atlas.mjs",
    "precheck:footprints": "node scripts/split-mesh-catalogs.mjs",
    "preassets:footprints": "node scripts/split-mesh-catalogs.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Starbugstone/Prospect-Hollow.git"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bugs": {
    "url": "https://github.com/Starbugstone/Prospect-Hollow/issues"
  },
  "homepage": "https://github.com/Starbugstone/Prospect-Hollow#readme",
  "dependencies": {
    "@capacitor/core": "^7.4.4",
    "howler": "^2.2.4",
    "phaser": "^3.86.0",
    "pinia": "^3.0.3",
    "three": "^0.183.2",
    "uqr": "^0.1.3",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-php": "^0.25.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "knip": "^6.38.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "vite": "^7.1.12",
    "vitest": "^4.0.10"
  }
}
