APP_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=https://game.example.com
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DATABASE?charset=utf8mb4
MAILER_DSN=smtp://USER:PASSWORD@smtp.example.com:587?require_tls=true
MAIL_FROM=game@example.com

# Explicit Capacitor origins; bearer tokens stay in app memory. Empty disables native transport.
NATIVE_ORIGINS=capacitor://localhost,http://localhost,https://localhost
