{
  "name": "prospect-hollow/backend",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.3",
    "ext-pdo": "*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/mailer": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/yaml": "7.4.*",
    "doctrine/dbal": "^4.3",
    "ext-intl": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    },
    "platform-check": true
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1"
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress --memory-limit=1G"
  }
}
