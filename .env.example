# Generate each independently: openssl rand -hex 32
APP_SECRET=replace-with-random-secret
DB_PASSWORD=replace-with-random-password
APP_ORIGIN=http://localhost:8094
APP_PORT=8094

# Advertising: local placeholders until provider/CMP access and runtime audit.
# To test without external requests: VITE_ADS_ENABLED=true, VITE_AD_PROVIDER=mock.
VITE_ADS_ENABLED=false
VITE_AD_PROVIDER=none
VITE_PRIVACY_PROVIDER=placeholder

# Live web setup (leave disabled until the requirements in docs/advertising.md are met).
VITE_GAMEMONETIZE_GAME_ID=replace-with-approved-game-id
VITE_GAMEMONETIZE_APPROVED=false
VITE_GAMEMONETIZE_PRIVACY_REVIEWED=false
VITE_COOKIEBOT_DOMAIN_GROUP_ID=replace-with-cookiebot-domain-group-id
VITE_PRIVACY_CONFIGURATION_REVIEWED=false
# Confirm the complete vendor inventory with GameMonetize; do not guess its vendor ID.
VITE_PRIVACY_VENDOR_IDS=
VITE_PRIVACY_GOOGLE_AC_VENDOR_IDS=
